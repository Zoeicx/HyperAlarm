# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# --- Kotlin / Java ---
-assumenosideeffects class kotlin.jvm.internal.Intrinsics {
    public static void check*(...);
    public static void throw*(...);
}
-assumenosideeffects class java.util.Objects {
    public static ** requireNonNull(...);
}

# --- App ---
-keep class com.hyperalarm.ui.** { *; }
-keep class com.hyperalarm.about.** { *; }
# MIUIX ships under TWO packages, and both are needed. The widgets themselves are `fan.*`
# (fan.cardview.HyperCardView); their support classes are `com.fan.support.*`
# (com.fan.support.cardview.BackgroundOutline). Neither exists in this source tree, so "grep finds
# nothing" is expected and is not a reason to delete these lines. Dropping com.fan.** produced
# `NoClassDefFoundError: com.fan.support.cardview.BackgroundOutline` when the about page inflated
# app_version_card; dropping fan.** breaks the widget itself. Verify with mapping.txt after a
# release build, not by opening one screen.
-keep class fan.** { *; }
-keep class com.fan.** { *; }

# --- Obfuscation ---
-keepattributes *Annotation*,RuntimeVisibleAnnotations,LineNumberTable,SourceFile,Signature
-renamesourcefileattribute SourceFile
-repackageclasses
-allowaccessmodification

# --- Room ---
-keep class * extends androidx.room.RoomDatabase { *; }
-keep class * extends androidx.room.RoomOpenHelper { *; }
-keep interface androidx.sqlite.db.SupportSQLiteOpenHelper { *; }
-keep interface androidx.sqlite.db.SupportSQLiteDatabase { *; }
-keep class androidx.room.util.TableInfo { *; }
-keep class androidx.room.util.TableInfo$Column { *; }
-keep class androidx.room.util.TableInfo$Index { *; }
-keep class androidx.room.util.TableInfo$ForeignKey { *; }
-dontwarn androidx.room.**

# --- fan.provider ---
-keep class fan.provider.Settings** { *; }
-keep class fan.provider.SettingsLiveData** { *; }

# --- Bridge contract ---
# Gson maps these classes by field name, and the names travel between the app and the
# clock process as JSON. Renaming them breaks parsing silently (every field reads as 0).
-keepnames class com.hyperalarm.common.alarm.**
-keepclassmembers class com.hyperalarm.common.alarm.** {
    <fields>;
}
