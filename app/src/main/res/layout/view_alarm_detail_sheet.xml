<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingBottom="24dp">

    <FrameLayout
        android:id="@+id/detail_header"
        android:layout_width="match_parent"
        android:layout_height="76dp">

        <ImageButton
            android:id="@+id/detail_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@null"
            android:contentDescription="@string/action_close"
            android:padding="12dp"
            android:src="@drawable/ic_alarm_close" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_edit_title"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/detail_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/detail_save"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:background="@null"
            android:contentDescription="@string/action_save"
            android:padding="12dp"
            android:src="@drawable/ic_alarm_check" />
    </FrameLayout>

    <com.hyperalarm.home.AlarmTimeWheelView
        android:id="@+id/detail_time_wheel"
        android:layout_width="match_parent"
        android:layout_height="279dp"
        android:layout_marginStart="8.5dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8.5dp"
        android:layout_marginBottom="55dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_alarm_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/detail_ring_master"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ringtone"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <fan.slidingwidget.widget.SlidingButton
                android:id="@+id/detail_ring_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detail_ringtone_row"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ringtone_choose"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/detail_ringtone_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/ringtone_element"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_alarm_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detail_repeat_row"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_title"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/detail_repeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_alarm_chevron" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_note_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_alarm_note"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/script"
            android:textColor="#F2FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detail_script"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/script_choose"
            android:textColor="#FF7CC7FF"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail_run"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_alarm_card"
        android:gravity="center"
        android:text="@string/script_run_now"
        android:textColor="#FF7CC7FF"
        android:textSize="16sp" />
</LinearLayout>
