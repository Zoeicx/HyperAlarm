<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      This module keeps the setup wizard's screens and helpers, but the flow itself is no longer
      launched (SplashActivity goes straight to the home page), so nothing here is exported: they used
      to be reachable by any app.
    -->
    <application>
        <activity
            android:name=".activity.DefaultActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name=".activity.PermissionSettingsActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name=".activity.TermsAndStatementActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name=".activity.BasicSettingsActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name=".activity.CongratulationActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <service
            android:name=".service.ProvisionAnimService"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="fan.intent.action.OOBSERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
